    "rules": [
      {
        "title": "'Es la una' but 'Son las dos...'",
        "spanish": "Es la una. Son las dos. Son las doce.",
        "english": "Only one o'clock is singular."
      },
      {
        "title": "Up to :30 add minutes with 'y'",
        "spanish": "las tres y diez, las tres y cuarto (:15), las tres y media (:30)",
        "english": "3:10, 3:15, 3:30"
      },
      {
        "title": "After :30 count back with 'menos' from the NEXT hour",
        "spanish": "las cuatro menos veinte (3:40), las cuatro menos cuarto (3:45), las cinco menos cinco (4:55)",
        "english": "3:40, 3:45, 4:55"
      },
      {
        "title": "Latin American 'faltan ... para'",
        "spanish": "Faltan quince para las cuatro. Faltan cinco para las cinco.",
        "english": "It's 3:45. It's 4:55."
      },
      {
        "title": "AM and PM are said with the part of the day",
        "spanish": "de la mañana (6-11), del día (12), de la tarde (1-7 p. m.), de la noche, de la madrugada (1-5 a. m.)",
        "english": "People rarely say 'a. m.'; they say 'de la mañana', 'de la tarde'... 'De la mañana' is also heard for early hours. Exact use varies by region and person."
      },
      {
        "title": "Schedules often use the 24-hour clock",
        "spanish": "15:45 → quince cuarenta y cinco; 21:00 → veintiuna horas",
        "english": "Flights, trains and appointments: 15:45 means 3:45 p. m."
      },
      {
        "title": "Handy extras",
        "spanish": "en punto (exactly), y pico (a bit after), casi las... (almost)",
        "english": "Son las tres en punto = it's exactly 3:00."
      }
    ],
