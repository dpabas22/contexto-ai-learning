  "phrases": [
    {
      "id": "p001",
      "category": "Restaurant/Café",
      "spanish": "Me da un café, por favor",
      "english": "Give me a coffee, please (polite Mexican way)",
      "pronunciation": "meh dah oon KA-feh, por fah-VOR",
      "context": "Ordering at café",
      "cultural_note": "This is how locals naturally order in Mexico, more natural than 'Un café, por favor'",
      "alternative": "¿Podría darme un café?"
    },
    {
      "id": "p002",
      "category": "Restaurant/Café",
      "spanish": "¿Podría recomendarnos un plato?",
      "english": "Could you recommend a dish to us?",
      "pronunciation": "poh-DREE-ah reh-koh-men-DAHR-nos oon PLAH-toh",
      "context": "Asking for menu advice",
      "cultural_note": "Polite request in restaurants",
      "alternative": "¿Qué me recomienda?"
    },
    {
      "id": "p003",
      "category": "Restaurant/Café",
      "spanish": "¿Podría traernos un poco más de agua?",
      "english": "Could you bring us more water?",
      "pronunciation": "poh-DREE-ah trah-EHR-nos oon POH-koh mahs deh AH-gwah",
      "context": "Requesting water during meal",
      "cultural_note": "Free water is standard in Mexican restaurants",
      "alternative": "Más agua, por favor"
    },
    {
      "id": "p004",
      "category": "Restaurant/Café",
      "spanish": "¿Podría traerle otra cuchara a mi hija?",
      "english": "Could you bring my daughter another spoon?",
      "pronunciation": "poh-DREE-ah trah-EHR-leh OH-trah koo-CHAH-rah ah mee EE-hah",
      "context": "Requesting items for children",
      "cultural_note": "Common in family dining situations",
      "alternative": "Una cuchara más, por favor"
    },
    {
      "id": "p005",
      "category": "Restaurant/Café",
      "spanish": "¿Puede traerme la cuenta, por favor?",
      "english": "Could you bring me the bill, please?",
      "pronunciation": "PWEH-deh trah-EHR-meh lah KWEN-tah, por fah-VOR",
      "context": "Requesting the check",
      "cultural_note": "Important: in Mexico, servers won't bring bill until asked",
      "alternative": "La cuenta, por favor"
    },
    {
      "id": "p006",
      "category": "Restaurant/Café",
      "spanish": "¿Este platillo lleva lácteos?",
      "english": "Does this dish contain dairy?",
      "pronunciation": "EHS-teh plah-TEE-yoh YEH-vah LAHK-teh-os",
      "context": "Checking ingredients (allergy/dietary)",
      "cultural_note": "Important for people with food sensitivities",
      "alternative": "¿Contiene leche este plato?"
    },
    {
      "id": "p007",
      "category": "Restaurant/Café",
      "spanish": "¿Podría hacerlo sin picante?",
      "english": "Could you make it without spice?",
      "pronunciation": "poh-DREE-ah ah-SEHR-loh seen pee-KAHN-teh",
      "context": "Requesting mild/non-spicy version",
      "cultural_note": "Mexican food can be quite spicy",
      "alternative": "Sin chile, por favor"
    },
    {
      "id": "p008",
      "category": "Restaurant/Café",
      "spanish": "¿Puedo pagar con tarjeta?",
      "english": "Can I pay by card?",
      "pronunciation": "PWEH-doh pah-GAHR kohn tahr-HEH-tah",
      "context": "Payment method inquiry",
      "cultural_note": "Some small local places only accept cash",
      "alternative": "¿Aceptan tarjeta de crédito?"
    },
    {
      "id": "p009",
      "category": "Restaurant/Café",
      "spanish": "¿Cuánto es la propina normal?",
      "english": "How much is the normal tip?",
      "pronunciation": "KWAN-toh es lah proh-PEE-nah NOR-mahl",
      "context": "Asking about tipping customs",
      "cultural_note": "Typically 10-15% in Mexico, similar to US",
      "alternative": "¿Qué porcentaje de propina?"
    },
    {
      "id": "p010",
      "category": "Restaurant/Café",
      "spanish": "Me trae la factura, por favor",
      "english": "Bring me the receipt, please",
      "pronunciation": "meh TRAH-eh lah fahk-TOO-rah, por fah-VOR",
      "context": "Requesting formal receipt",
      "cultural_note": "Different from 'cuenta' (bill) - formal for tax purposes",
      "alternative": "La factura, por favor"
    },
    {
      "id": "p011",
      "category": "Delivery",
      "spanish": "¡Hola! ¿Es de Amazon?",
      "english": "Hi! Is this from Amazon?",
      "pronunciation": "OH-lah. Ehs deh ah-mah-ZOHN",
      "context": "Answering door for delivery",
      "cultural_note": "Amazon Mexico is very popular, many deliveries",
      "alternative": "¿Qué empresa es?"
    },
    {
