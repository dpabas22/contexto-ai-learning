      "category": "Delivery",
      "spanish": "¿Lo puede dejar aquí, por favor?",
      "english": "Can you leave it here, please?",
      "pronunciation": "loh PWEH-deh deh-HAHR ah-KEE, por fah-VOR",
      "context": "Requesting package placement",
      "cultural_note": "Security concern: specify safe location",
      "alternative": "Déjalo en la puerta"
    },
    {
      "id": "p014",
      "category": "Delivery",
      "spanish": "¿Podría entregarlo mañana?",
      "english": "Could you deliver it tomorrow?",
      "pronunciation": "poh-DREE-ah ehn-treh-GAHR-loh mah-NYAH-nah",
